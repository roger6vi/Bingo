{
  "name": "bingo-desktop-feasibility",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "test:components:install": "playwright install chromium",
    "test:components": "npm run test:components:install && npm run build:tokens && ./node_modules/.bin/web-test-runner --config web-test-runner.config.mjs",
    "build:main": "tsc -p tsconfig.json",
    "build:tokens": "node scripts/build-tokens.mjs",
    "test:tokens": "node scripts/token-contract.mjs",
    "build:renderer": "npm run build:tokens && vite build",
    "build": "npm run build:main && npm run build:renderer",
    "test:build": "node --test verification/renderer-build.test.mjs",
    "test:smoke": "node verification/electron-smoke.mjs",
    "gallery": "npm run build:tokens && vite --open /gallery.html",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "@open-wc/testing": "5.0.0",
    "@types/node": "24.7.0",
    "@web/test-runner": "1.0.0",
    "@web/test-runner-playwright": "1.0.0",
    "electron": "41.10.3",
    "playwright": "1.63.0",
    "style-dictionary": "5.5.5",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "dependencies": {
    "@fontsource-variable/roboto-mono": "5.3.0",
    "lit": "3.3.2"
  }
}
