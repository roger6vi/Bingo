{
  "color": {
    "canvas": { "$type": "color", "$value": "{color.black}", "$description": "High-contrast page background" },
    "surface": { "$type": "color", "$value": "{color.black}" },
    "text": { "$type": "color", "$value": "{color.white}" },
    "muted": { "$type": "color", "$value": "{color.white}" },
    "accent": { "$type": "color", "$value": "{color.yellow}" },
    "danger": { "$type": "color", "$value": "{color.yellow}" },
    "focus": { "$type": "color", "$value": "{color.cyan}" },
    "border": { "$type": "color", "$value": "{color.white}" }
  },
  "space": {
